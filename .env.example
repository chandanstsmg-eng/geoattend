# ─────────────────────────────────────────────────────────────────────────────
# GeoAttend configuration. Copy to .env (or run `npm run setup`, which creates
# .env with freshly generated secrets). NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── API ──
API_PORT=4400
# Public address of the API. Production: https, required.
PUBLIC_API_URL=http://localhost:4400
# Origins allowed to call the API from a browser (comma separated). Production: https, required.
CORS_ORIGINS=http://localhost:3400
# Who may set the client address in X-Forwarded-For: the NUMBER of proxies in front of the API,
# or their addresses (10.0.0.1,10.0.0.0/8). Production: required, and "true" is refused because it
# would believe any address a client sends. Behind one proxy, use 1.
TRUST_PROXY=loopback

# ── Database ──
# Leave DATABASE_URL empty to use the built-in PostgreSQL (data/pg, started automatically).
# Production: postgresql://user:pass@host:5432/geoattend?sslmode=require  (PostGIS recommended)
DATABASE_URL=
PG_PORT=54340
PG_PASSWORD=change-me-run-npm-run-setup

# ── Auth ──
JWT_SECRET=change-me-at-least-32-characters-long-random
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS only).
COOKIE_SECURE=false

# ── Initial administrator (created by `npm run db:seed` if no admin exists) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ── Payroll ──
# Leave off until the pay rules (PF, ESI, PT, TDS, overtime) are confirmed by a qualified person.
# Off: no approval, net pay or salary sheets, enforced by the API. Attendance and hours reports are unaffected.
PAYROLL_ENABLED=false

# ── Photo deletion ──
# Leave off until the retention rules and legal requirements have been reviewed.
# Off: no job deletes employee photos, whatever a company has set. On: each company's owner still has to turn it on.
PHOTO_AUTO_DELETE_ENABLED=false

# ── Demo mode (development only; refused when NODE_ENV=production) ──
DEMO_MODE=true
DEMO_PASSWORD=

# ── Photo storage ──
# local: files under STORAGE_LOCAL_DIR served only through signed, expiring links.
# s3:    any S3-compatible private bucket (AWS S3, MinIO, R2) with pre-signed URLs. Required in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/photos
STORAGE_SIGNING_KEY=change-me-at-least-32-characters-long-random
MAX_PHOTO_BYTES=5242880
UPLOAD_URL_TTL_SEC=300
DOWNLOAD_URL_TTL_SEC=120
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
# When the API reaches the bucket on a private address: the https address phones and browsers use.
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Notifications (all optional) ──
# Admin browser push: generate with `npx web-push generate-vapid-keys` (npm run setup does this).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# E-mail alerts: smtp://user:pass@smtp.example.com:587
SMTP_URL=
EMAIL_FROM=GeoAttend <no-reply@example.com>
ALERT_EMAIL_RECIPIENTS=
# Daily summaries on WhatsApp (Meta WhatsApp Cloud API). Create a template named below with
# three body variables: {{1}} company, {{2}} date/time, {{3}} summary. Empty = messages are logged.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SUMMARY_TEMPLATE=daily_summary
WHATSAPP_TEMPLATE_LANGUAGE=en
# Automatic face match of attendance photos against each employee's reference photo.
# local (default) — compare shift photos with the employee's enrolled face using an open-source
# model inside the API server (no external service, photos never leave the server); off — no comparison.
FACE_MATCH_PROVIDER=local
# Similarity (%) a photo needs to count as the same person; lower ones go to a manager for review.
FACE_MATCH_THRESHOLD=60
# Link included in summaries
DASHBOARD_URL=http://localhost:3400
# Employee device push via the Expo push service (FCM/APNs). Requires an EAS project.
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# ── Admin dashboard (Next.js) ──
# Where the dashboard's server-side proxy reaches the API.
API_INTERNAL_URL=http://localhost:4400
# Release builds only (Dockerfiles set GEOATTEND_RELEASE=true): the https origin of the photo bucket.
PHOTO_ORIGIN=
# Browser key for Google Maps JavaScript API + Places (restrict by HTTP referrer!).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (required for Advanced Markers styling). Leave empty to use DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Public website (Next.js). Built into the site, so set before building ──
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_BRAND_LOGO_URL=

SWEEPER_INTERVAL_MS=15000
LOG_LEVEL=info
