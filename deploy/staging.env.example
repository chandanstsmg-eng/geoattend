# GeoAttend STAGING settings for docker-compose.yml on an Ubuntu server.
# deploy/staging-bootstrap.sh copies this to /opt/geoattend/.env (chmod 600) and fills every
# GENERATE_ME with fresh random secrets. It never overwrites an existing .env.
# Replace every REPLACE_ME and example.com by hand. The API refuses to start while any are left.
# Never commit the filled file. Staging must use its OWN secrets, never production's.

NODE_ENV=production

# ── Addresses (the host names in deploy/Caddyfile) ──
PUBLIC_API_URL=https://api.staging.example.com
DASHBOARD_URL=https://app.staging.example.com
CORS_ORIGINS=https://app.staging.example.com
NEXT_PUBLIC_SITE_URL=https://staging.example.com
S3_PUBLIC_ENDPOINT=https://photos.staging.example.com
# Caddy on the same host is one proxy.
TRUST_PROXY=1

# ── Secrets (generated) ──
PG_PASSWORD=GENERATE_ME
PG_OWNER_PASSWORD=GENERATE_ME
PG_TENANT_PASSWORD=GENERATE_ME
JWT_SECRET=GENERATE_ME
STORAGE_SIGNING_KEY=GENERATE_ME
OPS_TOKEN=GENERATE_ME
# MinIO root login, also the API's bucket credentials on this single-host stack.
S3_ACCESS_KEY_ID=GENERATE_ME
S3_SECRET_ACCESS_KEY=GENERATE_ME
S3_BUCKET=geoattend-photos

# ── First administrator (db:seed). Set a strong password, then remove it from this file after seeding ──
ADMIN_EMAIL=REPLACE_ME@example.com
ADMIN_PASSWORD=GENERATE_ME
ADMIN_NAME=Staging Administrator

# ── Kept off (business approval required) ──
PAYROLL_ENABLED=false
PHOTO_AUTO_DELETE_ENABLED=false
DEMO_MODE=false

# ── Integrations. Leave a value EMPTY until a real credential exists: empty means "not configured"
# (logged only), which the checks report as BLOCKED. Never put a made-up or sample value here.
# Prove each one with:  docker compose exec api npm run integrations:check -w @geoattend/api -- …
# (docs/STAGING.md, section 3). Formats are shown in the comments; none of these values is real.

# Alerts to a person. Webhook: an https URL from your alerting tool (Slack/Teams/PagerDuty-style JSON POST).
#   ALERT_WEBHOOK_URL=https://hooks.<provider>/<path>
#   OPS_ALERT_EMAILS=oncall@<your-domain>,owner@<your-domain>     (needs SMTP_URL)
ALERT_WEBHOOK_URL=
OPS_ALERT_EMAILS=

# SMTP from your mail provider (port 587 with STARTTLS). URL-encode special characters in the password.
#   SMTP_URL=smtp://<user>:<password>@<smtp-host>:587
#   EMAIL_FROM=GeoAttend <no-reply@<your-domain>>        (domain with SPF and DKIM set up)
SMTP_URL=
EMAIL_FROM=
ALERT_EMAIL_RECIPIENTS=

# Dashboard browser push: generate a pair with  npx web-push generate-vapid-keys  (private key stays here).
#   VAPID_SUBJECT=mailto:admin@<your-domain>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# WhatsApp Cloud API (Meta Business): a permanent system-user token, the sender's phone number ID, and an
# APPROVED template with three body variables ({{1}} company, {{2}} date/time, {{3}} summary).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SUMMARY_TEMPLATE=daily_summary
WHATSAPP_TEMPLATE_LANGUAGE=en

# Employee phone push through Expo (FCM for Android): an access token from expo.dev → Access tokens, for the
# EAS project the app is built with (FCM v1 credentials uploaded with  eas credentials).
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Google Maps. This key is PUBLIC by design (it ships in the dashboard's JavaScript), so it must be locked down
# in Google Cloud: application restriction "Websites" = https://app.staging.<your-domain>/* only; API
# restriction = Maps JavaScript API + Places API only; billing on, with a budget alert. Use a separate key
# for production. The Map ID is a "JavaScript / Vector" map ID from the same project. Both are built into the
# admin image: rebuild it (staging-deploy.sh) after changing them.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# External monitoring is configured in the monitoring service, not here: poll
#   https://api.staging.<your-domain>/health   every 1 minute, alert after 2 failures
# Optional deeper check (send header  Authorization: Bearer <OPS_TOKEN>):
#   https://api.staging.<your-domain>/api/v1/ops/health
# Off-site backup storage is configured in /etc/geoattend/backup.env (deploy/backup.env.example).

LOG_LEVEL=info
