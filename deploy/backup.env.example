# Settings for the nightly backup job (docker-compose.yml service `backup`, docs/BACKUPS.md).
# Copy to /etc/geoattend/backup.env, chown root:root, chmod 600. Never commit the filled file.
# DATABASE_URL, PG_BIN and BACKUP_DIR are set by docker-compose.yml.

# A login that may create databases, for the restore check. On the single-host stack this is the
# PostgreSQL administrator of the `db` service (user geoattend, PG_PASSWORD from .env), on database postgres.
# Better: another PostgreSQL server, so the check does not load production.
BACKUP_VERIFY_DATABASE_URL=postgresql://geoattend:REPLACE_ME@db:5432/postgres

# Off-site copy: a bucket in ANOTHER account or provider, with versioning or object lock, and a key
# that can only write to this prefix. With BACKUP_S3_BUCKET empty the run still proves the restore but
# keeps the dump on this machine only, and says so in the log: not acceptable for production.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_S3_PREFIX=geoattend-staging/
BACKUP_OFFSITE_KEEP=30
