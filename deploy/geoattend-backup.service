# Nightly production backup: dump, restore check, off-site copy, retention (docs/BACKUPS.md).
# Install: copy this file and geoattend-backup.timer to /etc/systemd/system/, then
#   systemctl daemon-reload && systemctl enable --now geoattend-backup.timer
# Run once by hand first:  systemctl start geoattend-backup.service && journalctl -u geoattend-backup -n 50
# NOT YET RUN ON A LINUX SERVER. Check the paths before enabling.
#
# It runs the `backup` service of docker-compose.yml in the API image, which carries pg_dump 17, so the
# host needs Docker only. Secrets: /opt/geoattend/.env (database passwords) and /etc/geoattend/backup.env
# (off-site bucket, restore-check login), both chmod 600, never in this unit.
[Unit]
Description=GeoAttend production backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/geoattend
ExecStart=/usr/bin/docker compose --profile backup run --rm backup
# A failed run exits 1 and writes a FAILED manifest; the API's hourly backup check then raises an alert.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
