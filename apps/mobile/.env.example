# Copy to .env and adjust. Values are read when Metro bundles / EAS builds the app.

# API base URL. A phone cannot reach "localhost" on your PC — use the PC's LAN IP
# (PowerShell: `ipconfig`, look for the IPv4 address of your Wi-Fi/Ethernet adapter).
# Production builds must use https://.
EXPO_PUBLIC_API_URL=http://192.168.x.x:4400

# Google Maps SDK for Android key (restrict it to the app's package + SHA-1 in Google Cloud).
# Without it the Workplace map screen shows coordinates and radius instead of a map.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional: EAS project id (from `npx eas-cli@latest init`). Enables Expo push tokens.
# Local notifications work without it.
EAS_PROJECT_ID=

# Optional: development | preview | production (eas.json sets this per build profile).
# APP_VARIANT=development

# Optional: set to 1 to allow plain-HTTP API traffic in a *preview* build for LAN testing.
# Never set this for production.
# ALLOW_CLEARTEXT=
