{
  "name": "@geoattend/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx watch --clear-screen=false --exclude \"data/**\" src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "set-logins": "tsx scripts/set-logins.ts",
    "db:stop": "tsx scripts/db-stop.ts",
    "jobs:status": "tsx scripts/jobs-status.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:backup:online": "tsx scripts/backup-online.ts",
    "db:backup:verify": "tsx scripts/backup-verify.ts",
    "db:backup:prune": "tsx scripts/backup-prune.ts",
    "db:schema-doc": "tsx scripts/schema-doc.ts",
    "db:restore": "tsx scripts/restore.ts",
    "openapi": "tsx scripts/openapi.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:seed": "tsx scripts/sample-seed.ts",
    "demo:verify": "tsx scripts/sample-verify.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@geoattend/shared": "*",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vladmandic/human": "^3.3.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "jpeg-js": "^0.4.4",
    "luxon": "^3.7.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-dist": "^5.34.0",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
